# ── Application ─────────────────────────────────────────────
ENVIRONMENT=development
# Database URL (SQLite for local dev; use postgres:// for production)
DATABASE_URL=sqlite+aiosqlite:///./data/observatory.db

# ── Server ──────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── OIDC / Keycloak (future milestone — leave empty for now) ─
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=

# ── LLM advisory (optional — leave empty for offline mode) ──
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=