      "runtime": "Python 3.12",
      "framework": "FastAPI",
      "database": "SQLite (async SQLAlchemy + aiosqlite)",
      "ml_engine": "From-scratch TF-IDF + logistic regression (no numpy/sklearn)"
    },
    "frontend": {
      "runtime": "React 18 + TypeScript",
      "build": "Vite",
      "test": "Vitest + Testing Library"
    }
  },
  "endpoints": {
    "health": "GET /health",
    "parse": "POST /api/v1/links",
    "list": "GET /api/v1/links",
    "detail": "GET /api/v1/links/{id}",
    "export": "GET /api/v1/links/export",
    "statuses": "GET /api/v1/statuses",
    "classify": "POST /api/v1/classify",
    "providers": "GET /api/v1/providers",
    "evaluate": "POST /api/v1/evaluate"
  },
